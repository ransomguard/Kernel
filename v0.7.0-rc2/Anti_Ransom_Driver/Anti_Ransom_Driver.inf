; Optional primitive package for the non-PnP KMDF control driver.
; Reconstructed source package: Windows WDK validation is still required.
; Windows 10/11 supplies KMDF; no co-installer is installed.

[Version]
Signature = "$WINDOWS NT$"
Class = System
ClassGuid = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider = %ProviderName%
DriverVer = 11/05/2026,0.7.0.0
CatalogFile = Anti_Ransom_Driver.cat
PnpLockdown = 1

[DestinationDirs]
DriverFiles = 13

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
Anti_Ransom_Driver.sys = 1

[DefaultInstall.NTamd64]
CopyFiles = DriverFiles

[DefaultInstall.NTamd64.Services]
AddService = Anti_Ransom_Driver,,ControlDriver.Service

[ControlDriver.Service]
DisplayName = %ServiceName%
Description = %ServiceDescription%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\Anti_Ransom_Driver.sys
AddReg = ControlDriver.Parameters

[ControlDriver.Parameters]
; DWORD + NOCLOBBER: new installations observe; preserve an existing policy.
HKR,"Parameters","FastPathMode",0x00010003,1

[DriverFiles]
Anti_Ransom_Driver.sys

[Strings]
ProviderName = "RansomGuard University Project"
DiskName = "RansomGuard control driver package"
ServiceName = "RansomGuard control driver"
ServiceDescription = "RansomGuard KMDF control, process events and response"

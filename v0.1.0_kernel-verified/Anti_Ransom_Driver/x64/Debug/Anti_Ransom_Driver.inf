;
; Anti_Ransom_Driver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = Anti_Ransom_Driver.cat
DriverVer = 09/18/2026,22.23.30.297
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
Anti_Ransom_Driver.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...16299 ; %13% support introduced in build 16299

[Standard.NTamd64.10.0...16299]
%Anti_Ransom_Driver.DeviceDesc% = Anti_Ransom_Driver_Device, Root\Anti_Ransom_Driver ; TODO: edit hw-id

[Anti_Ransom_Driver_Device.NT]
CopyFiles = File_Copy

[File_Copy]
Anti_Ransom_Driver.sys

;-------------- Service installation
[Anti_Ransom_Driver_Device.NT.Services]
AddService = Anti_Ransom_Driver,%SPSVCINST_ASSOCSERVICE%, Anti_Ransom_Driver_Service_Inst

; -------------- Anti_Ransom_Driver driver install sections
[Anti_Ransom_Driver_Service_Inst]
DisplayName    = %Anti_Ransom_Driver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\Anti_Ransom_Driver.sys

[Anti_Ransom_Driver_Device.NT.Wdf]
KmdfService = Anti_Ransom_Driver, Anti_Ransom_Driver_wdfsect

[Anti_Ransom_Driver_wdfsect]
KmdfLibraryVersion = 1.15

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "Anti_Ransom_Driver Installation Disk"
Anti_Ransom_Driver.DeviceDesc = "Anti_Ransom_Driver Device"
Anti_Ransom_Driver.SVCDESC = "Anti_Ransom_Driver Service"
